# =============================================================================
# GuideToDream — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=              # random secret string, used for signing tokens
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# Get from: Supabase → Settings → Database → Connection string
# For async SQLAlchemy, the prefix must be postgresql+asyncpg://
# For Alembic (sync), use postgresql+psycopg2://
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# LLM — Google Gemini (free tier)
# Get from: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# Model routing
LLM_FAST_MODEL=gemini/gemini-3.6-flash     # cheap, fast — most tasks
LLM_SMART_MODEL=gemini/gemini-3.6-flash      # update when pro tier available

# -----------------------------------------------------------------------------
# Web Search — Tavily (1000 free searches/month)
# Get from: https://tavily.com
# -----------------------------------------------------------------------------
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Notifications — Telegram Bot
# Create a bot: https://t.me/BotFather → /newbot
# Get your chat ID: https://t.me/userinfobot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Playwright (for dynamic page rendering)
# Set to true to enable JS-rendered page fetching
# -----------------------------------------------------------------------------
PLAYWRIGHT_ENABLED=false
