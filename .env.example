# =============================================================================
# GuideToDream — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=              # random secret string, used for signing tokens
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# IMPORTANT: Use the CONNECTION POOLER URL, not the direct connection.
# Direct connection (db.*.supabase.co) uses IPv6 which may fail on some networks.
# Get pooler URL from: Supabase → Settings → Database → Connection Pooling
#
# Transaction mode (port 6543) for the async app:
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Session mode (port 5432) for Alembic migrations:
DATABASE_URL_SYNC=postgresql+psycopg2://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# LLM — Google Gemini (free tier)
# Get from: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# Model routing
LLM_FAST_MODEL=gemini/gemini-3.6-flash     # cheap, fast — most tasks
LLM_SMART_MODEL=gemini/gemini-3.6-flash      # update when pro tier available

# -----------------------------------------------------------------------------
# Web Search — Tavily (1000 free searches/month)
# Get from: https://tavily.com
# -----------------------------------------------------------------------------
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Notifications — Telegram Bot
# Create a bot: https://t.me/BotFather → /newbot
# Get your chat ID: https://t.me/userinfobot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Scheduling
# -----------------------------------------------------------------------------
# Times in 24h format, server local time
RESEARCH_SCHEDULE_HOUR=8        # Full research cycle
RESEARCH_SCHEDULE_MINUTE=0
DEADLINE_CHECK_HOUR=14          # Deadline reminders
DEADLINE_CHECK_MINUTE=0
DAILY_SUMMARY_HOUR=21           # Daily summary
DAILY_SUMMARY_MINUTE=0
SCHEDULER_ENABLED=true          # Set false to disable all scheduled jobs
