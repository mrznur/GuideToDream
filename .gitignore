# =============================================================================
# GuideToDream — .gitignore
# =============================================================================

# Environment & secrets — NEVER commit these
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv
.uv/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checking
.mypy_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database (local)
*.db
*.sqlite3

# Playwright browsers
playwright-browsers/

# Alembic (keep versions, ignore cache)
alembic/__pycache__/
